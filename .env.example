# URL của Backend API (Spring Boot)
VITE_API_URL=http://localhost:8080

# URI redirect sau khi đăng nhập bằng Google OAuth2
VITE_OAUTH2_REDIRECT_URI=/oauth2/callback/google

# Key lưu JWT token trong localStorage
VITE_TOKEN_KEY=campushub_token

# URL endpoint WebSocket (STOMP over SockJS)
VITE_WS_URL=http://localhost:8080/ws
